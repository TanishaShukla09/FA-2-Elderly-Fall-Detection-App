# Optional TURN relay for deployed Streamlit WebRTC.
# Copy this file to .streamlit/secrets.toml and replace these values only when
# your deployment shows a persistent WebRTC connection warning. Never commit
# the real secrets file.
# TURN_URL = "turn:your-turn-provider.example:3478"
# TURN_USERNAME = "your-username"
# TURN_PASSWORD = "your-password"
